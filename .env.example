# 개발 환경 설정 예시. 복사해서 .env로 쓴다 (cp .env.example .env). .env는 커밋하지 않는다.
# 값은 개발용 자리표시자다. 운영 값은 비밀 저장소에서 주입한다.

# --- PostgreSQL (소유자=마이그레이션, 앱=API·워커)
POSTGRES_USER=marine_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=marine
APP_DB_USER=marine_app
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql+pg8000://marine_app:change-me-app@postgres:5432/marine
MIGRATION_DATABASE_URL=postgresql+pg8000://marine_owner:change-me-owner@postgres:5432/marine

# --- S3 호환 스토리지 (개발: SeaweedFS). 운영 제품이 정해지면 주소·버킷만 바꾼다 (HW-1)
S3_ENDPOINT_URL=http://seaweedfs:8333
# 사전 서명 URL에 쓰는 주소 (에이전트·브라우저가 접근하는 주소)
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dev-access
S3_SECRET_ACCESS_KEY=change-me-s3
S3_FORCE_PATH_STYLE=true
BUCKET_RAW=raw
BUCKET_PROC=proc
BUCKET_EVIDENCE=evidence
BUCKET_DATASETS=datasets
BUCKET_QUARANTINE=quarantine

# --- IdP (Keycloak). 발급자는 브라우저 기준 주소, 내부 주소는 컨테이너 간 통신용
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc
IDP_ISSUER_URL=http://localhost:8080/realms/marine
IDP_INTERNAL_URL=http://keycloak:8080/realms/marine
IDP_AUDIENCE=marine-api

# --- 기기·API 키 단기 토큰 서명 키 (32자 이상)
DEVICE_TOKEN_SIGNING_KEY=change-me-device-token-signing-key-32chars
DEVICE_TOKEN_TTL_S=300
ENROLLMENT_CODE_TTL_S=86400

# --- 기능 (HW-2, HW-3)
GPU_ENABLED=false
PROCESSING_STEPS=META
# 보고서 내보내기 (10번). PDF는 Pillow·Pyphen 라이선스 예외 승인 대기 (ADR-0018) — 승인 전 운영에서는 빼도 된다
REPORT_FORMATS=XLSX,HWPX,PDF
EXTERNAL_SOURCES=
PRESIGN_UPLOAD_TTL_S=900
PRESIGN_DOWNLOAD_TTL_S=300
LOG_LEVEL=INFO

# --- 업로드·쿼터 (HW-3)
UPLOAD_PART_SIZE=67108864
UPLOAD_SESSION_TTL_S=604800
DEFAULT_ORG_QUOTA_BYTES=10995116277760
RATE_LIMIT_PER_MINUTE=600

# --- 수집 모니터링·알림 (11번). 메일 서버가 없으면 로그로만 남는다.
# 개발: make up 후 `docker compose --profile ops up -d mailpit` 하고 SMTP_HOST=mailpit, 받은 메일은 http://localhost:8025
SMTP_HOST=
SMTP_PORT=1025
MAIL_FROM=marine-platform@localhost
ALERT_WEBHOOK_URL=
WATCH_EVAL_INTERVAL_S=60

# 계층형 백업 (08번, ADR-0021·0022). API·워커 이미지에 PostgreSQL 16 도구 포함
BACKUP_ENABLED=false
BACKUP_INTERVAL_H=24
BACKUP_BUCKET=backup
# 운영에서는 다른 장비·위치의 S3를 지정한다. 빈 값이면 개발용 공용 S3의 BACKUP_BUCKET 사용
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Compose의 migrate·worker만 사용. 빈 값이면 MIGRATION_DATABASE_URL(소유자 계정)
BACKUP_DATABASE_URL=
