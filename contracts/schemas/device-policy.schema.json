{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "수집기 정책 v1.0 (GET /v1/devices/{id}/policy 응답)",
  "description": "에이전트(수집기)가 받아 적용하는 정책. 수집기 하나가 매핑된 원천 장비 여러 대를 맡는다 (domain.md 1장). 숫자는 모두 운영 정책 테이블 값이다 (tech.md HW-3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "collector_device_id", "sources", "watch_rules", "heartbeat_interval_s", "size_stable_s", "timezone"],
  "properties": {
    "policy_version": { "type": "string", "maxLength": 64 },
    "collector_device_id": { "$ref": "common.schema.json#/$defs/device_id" },
    "sources": {
      "description": "이 수집기가 데이터를 보낼 수 있는 원천 장비와 장비별 정책",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["device_id", "collection_mode", "local_copy_policy", "allowed_data_roles"],
        "properties": {
          "device_id": { "$ref": "common.schema.json#/$defs/device_id" },
          "project_id": { "$ref": "common.schema.json#/$defs/project_id" },
          "collection_mode": { "$ref": "common.schema.json#/$defs/collection_mode" },
          "local_copy_policy": { "$ref": "common.schema.json#/$defs/local_copy_policy" },
          "local_retention_days": { "type": ["integer", "null"], "minimum": 0 },
          "allowed_data_roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/data_role" } },
          "expected_interval_s": { "type": ["integer", "null"], "minimum": 1, "description": "기대 수집 주기. 수집 정상성 판정에 쓴다 (11번)" },
          "source_timezone": { "oneOf": [{ "$ref": "common.schema.json#/$defs/iana_timezone" }, { "type": "null" }] },
          "observation_mapping_version": { "type": ["string", "null"] }
        }
      }
    },
    "watch_rules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "source_device_id", "path_pattern", "data_role_default"],
        "properties": {
          "rule_id": { "type": "string", "maxLength": 64 },
          "source_device_id": { "$ref": "common.schema.json#/$defs/device_id" },
          "path_pattern": { "type": "string", "maxLength": 256, "examples": ["{session}/cam01/*"] },
          "include": { "type": "array", "items": { "type": "string" } },
          "exclude": { "type": "array", "items": { "type": "string" } },
          "data_type": { "$ref": "common.schema.json#/$defs/data_type" },
          "variant": { "$ref": "common.schema.json#/$defs/variant" },
          "data_role_default": { "$ref": "common.schema.json#/$defs/data_role" },
          "priority": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "transfer_windows": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["days", "start_local", "end_local"],
        "properties": {
          "days": { "type": "array", "items": { "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] }, "uniqueItems": true, "minItems": 1 },
          "start_local": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "end_local": { "type": "string", "pattern": "^([01][0-9]|2[0-4]):[0-5][0-9]$", "description": "start보다 이르면 다음 날까지 이어진다" },
          "max_kbps": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "timezone": { "$ref": "common.schema.json#/$defs/iana_timezone" },
    "heartbeat_interval_s": { "type": "integer", "minimum": 30 },
    "size_stable_s": { "type": "integer", "minimum": 1 },
    "max_parallel_parts": { "type": "integer", "minimum": 1 },
    "auto_update": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" }, "channel": { "enum": ["stable", "pilot"] } }
    }
  }
}
