{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "데이터셋 버전 매니페스트 v1.0",
  "description": "수정할 수 없는 데이터셋 버전의 파일 목록과 데이터 카드 (13번). 데이터 카드 항목은 기준 문서 18.2장. 필수 항목이 비면 게시할 수 없다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "dataset_version_id", "version", "created_at", "provider_organization_ids", "items", "item_count", "total_bytes", "data_card"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "dataset_id": { "$ref": "common.schema.json#/$defs/dataset_id" },
    "dataset_version_id": { "$ref": "common.schema.json#/$defs/dataset_version_id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "created_at": { "$ref": "common.schema.json#/$defs/utc_datetime" },
    "provider_organization_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/organization_id" } },
    "item_count": { "type": "integer", "minimum": 1 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["asset_id", "source_asset_id", "variant", "path", "byte_size", "checksum_sha256", "privacy_status", "sharing_scope", "legal_basis_ref"],
        "properties": {
          "asset_id": { "$ref": "common.schema.json#/$defs/asset_id" },
          "source_asset_id": { "$ref": "common.schema.json#/$defs/asset_id" },
          "variant": { "enum": ["DEID", "PROXY", "CLIP", "THUMBNAIL", "ANNOTATION", "SENSOR_EXPORT", "DOCUMENT"] },
          "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,512}$", "description": "패키지 안의 상대 경로. 원래 파일명을 쓰지 않는다." },
          "byte_size": { "type": "integer", "minimum": 0 },
          "checksum_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "privacy_status": { "enum": ["NOT_APPLICABLE", "PSEUDONYMIZED", "ANONYMIZED_VERIFIED"] },
          "sharing_scope": { "enum": ["SANDBOX_PARTNERS", "APPROVED_PARTNERS", "PUBLIC"] },
          "legal_basis_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "data_card": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "rights_holders", "review_owner", "source_summary", "contents", "conditions", "privacy", "lineage", "usage", "delivery"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "rights_holders": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "review_owner": { "type": "string", "minLength": 1 },
        "source_summary": {
          "type": "object", "additionalProperties": false, "required": ["organization_count", "session_count", "period_start", "period_end", "sea_areas_generalized"],
          "properties": {
            "organization_count": { "type": "integer", "minimum": 1 },
            "session_count": { "type": "integer", "minimum": 0 },
            "device_types": { "type": "array", "items": { "type": "string" } },
            "period_start": { "type": "string", "format": "date" },
            "period_end": { "type": "string", "format": "date" },
            "sea_areas_generalized": { "type": "array", "items": { "type": "string" }, "description": "일반화한 해역 이름만 (정밀 좌표 금지)" }
          }
        },
        "contents": {
          "type": "object", "additionalProperties": false, "required": ["file_count", "total_bytes", "formats"],
          "properties": {
            "file_count": { "type": "integer", "minimum": 1 },
            "total_duration_s": { "type": "number", "minimum": 0 },
            "total_bytes": { "type": "integer", "minimum": 0 },
            "formats": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "label_schema": { "type": "string" }
          }
        },
        "conditions": {
          "type": "object", "additionalProperties": false, "required": ["missing_data_note", "bias_note", "limitations"],
          "properties": {
            "environment_distribution": { "type": "object" },
            "missing_data_note": { "type": "string", "minLength": 1 },
            "bias_note": { "type": "string", "minLength": 1 },
            "limitations": { "type": "string", "minLength": 1 }
          }
        },
        "privacy": {
          "type": "object", "additionalProperties": false, "required": ["risk_note", "processing_methods", "review_method"],
          "properties": {
            "risk_note": { "type": "string", "minLength": 1 },
            "confidentiality_note": { "type": "string" },
            "processing_methods": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "review_method": { "type": "string", "minLength": 1 }
          }
        },
        "lineage": {
          "type": "object", "additionalProperties": false, "required": ["model_versions"],
          "properties": {
            "model_versions": { "type": "array", "items": { "type": "string" } },
            "tool_versions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "usage": {
          "type": "object", "additionalProperties": false, "required": ["allowed_purposes", "redistribution_allowed", "commercial_use_allowed", "revocation_terms"],
          "properties": {
            "allowed_purposes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/purpose" } },
            "redistribution_allowed": { "type": "boolean" },
            "commercial_use_allowed": { "type": "boolean" },
            "period_note": { "type": "string" },
            "revocation_terms": { "type": "string", "minLength": 1 },
            "attribution": { "type": "string" }
          }
        },
        "delivery": {
          "type": "object", "additionalProperties": false, "required": ["methods"],
          "properties": {
            "methods": { "type": "array", "minItems": 1, "items": { "enum": ["DOWNLOAD_URL", "API"] } },
            "approval_ref": { "type": "string" }
          }
        }
      }
    }
  }
}
