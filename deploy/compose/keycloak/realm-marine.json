{
  "realm": "marine",
  "enabled": true,
  "displayName": "해양 실증데이터 플랫폼 (개발)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "browserFlow": "browser-mfa",
  "directGrantFlow": "direct-grant-mfa",
  "clients": [
    {
      "clientId": "marine-web",
      "name": "플랫폼 웹",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*",
        "default.acr.values": "2"
      },
      "protocolMappers": [
        {
          "name": "audience-marine-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "marine-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "marine-dev-cli",
      "name": "개발용 CLI (운영 금지)",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-marine-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "marine-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "mfa-required",
        "description": "IdP 내부 표지: 로그인 때 OTP를 거쳐야 한다 (ADR-0034). ORG_ADMIN·PLATFORM_OPERATOR가 포함한다. API 권한 판단에는 쓰지 않는다."
      },
      {
        "name": "ORG_ADMIN",
        "description": "플랫폼 DB users.roles의 ORG_ADMIN과 같게 둔다. 권한 판단은 플랫폼 DB 기준이고, 여기서는 MFA 강제에만 쓴다.",
        "composite": true,
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "PLATFORM_OPERATOR",
        "description": "플랫폼 DB users.roles의 PLATFORM_OPERATOR와 같게 둔다. 권한 판단은 플랫폼 DB 기준이고, 여기서는 MFA 강제에만 쓴다.",
        "composite": true,
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      }
    ]
  },
